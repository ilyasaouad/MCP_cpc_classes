# patent_cpc_API — environment variables
# Copy this file to .env and fill in your values.

# ── LLM ───────────────────────────────────────────────────────
# Model used for Phase 5B professional justification (and Phase 1A/1B/5A if using Claude)
LLM_MODEL=claude-opus-4-7

# Anthropic API key (needed if LLM_MODEL is a Claude model)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Knowledge Graph ────────────────────────────────────────────
# Set to 1 to skip KG loading entirely (LLM-only mode, faster startup)
SKIP_KG=0

# Set to 1 to skip rebuilding KG from XML (use existing cache)
SKIP_KG_REBUILD=1

# Override the KG cache directory (default: ../patent_cpc_fastapi/app/cpc_classification/resources)
# KG_CACHE_DIR=C:/path/to/resources

# Override the XML scheme directory
# XML_DIR=C:/path/to/cpc_scheme_2026

# ── Server ─────────────────────────────────────────────────────
# Port for this API (must differ from patent_cpc_fastapi which uses 8000)
PORT=8001
