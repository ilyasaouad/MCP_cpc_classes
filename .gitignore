# ============================================================
# GENERAL EXCLUSIONS
# ============================================================
**/.DS_Store
**/Thumbs.db
**/*.swp
**/.vscode/
**/.idea/

# ============================================================
# PYTHON
# ============================================================
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/
**/env/

# ============================================================
# NODE.JS
# ============================================================
**/node_modules/
**/dist/

# ============================================================
# LOGS & TEMP FILES
# ============================================================
**/*.log
**/ollama_response.txt
**/nul

# ============================================================
# ENVIRONMENT & SECRETS
# ============================================================
**/.env
**/.env.local
**/.env.*.local

# ============================================================
# JUPYTER
# ============================================================
**/.ipynb_checkpoints/
**/*.ipynb_checkpoints

# ============================================================
# LARGE MODEL/DATA FILES
# ============================================================
*.pkl
*.bin
*.pt
*.pth
*.h5
*.onnx
*.safetensors

# ============================================================
# VECTOR DATABASES (generated at runtime)
# ============================================================
**/.chroma/
**/chroma_db/

# ============================================================
# CPC RESOURCES (large downloaded data)
# ============================================================
/patent_cpc_fastapi/app/cpc_classification/resources/cpc_scheme_2026/*.xml
/patent_cpc_fastapi/app/cpc_classification/resources/cpc_scheme_2026/*.json

# ============================================================
# OTHER PROJECTS (not part of this repo)
# ============================================================
/patent_application_anlayse_langgraph/
/patent_document_analyse/

# ============================================================
# PROJECT-SPECIFIC EXCLUSIONS
# ============================================================

# MCP_patent_classification
/MCP_patent_classification/node_modules/
/MCP_patent_classification/dist/
/MCP_patent_classification/.env
/MCP_patent_classification/*.log

# patent_cpc_fastapi
/patent_cpc_fastapi/.venv/
/patent_cpc_fastapi/__pycache__/
/patent_cpc_fastapi/app/__pycache__/
/patent_cpc_fastapi/app/**/*.pyc
/patent_cpc_fastapi/.ruff_cache/
/patent_cpc_fastapi/.env
/patent_cpc_fastapi/app/cpc_classification/resources/chroma_db/
/patent_cpc_fastapi/ollama_response.txt

# cpc_client
/cpc_client/.venv/
/cpc_client/__pycache__/
/cpc_client/.ruff_cache/
/cpc_client/.env
